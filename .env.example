# TraceGuard Environment Configuration
# Copy this file to .env and set your values. Never commit .env to version control!

# OpenAI API Key (Optional for offline deterministic tests; required for LLM classification, generation, and LLM judge)
OPENAI_API_KEY=your_openai_api_key_here

# Offline Mode: set to 1 to force offline deterministic heuristics even if an API key is present
OFFLINE_MODE=0

# Model configurations (override if needed)
CLASSIFY_MODEL=gpt-4o-mini
REPLY_MODEL=gpt-4o
JUDGE_MODEL=gpt-4o
